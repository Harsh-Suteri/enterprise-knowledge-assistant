# Copy to .env and fill in. Leave the key blank to run retrieval-only.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# Generation backend: "openai" (default) or "ollama" to run a local model.
# With ollama, no key is needed and nothing leaves the machine.
LLM_BACKEND=openai
# From inside a container use http://host.docker.internal:11434/v1 --
# localhost there means the container, not the host running Ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
