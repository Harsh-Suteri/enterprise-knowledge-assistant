.chroma/
__pycache__/
*.pyc
.env
venv/
.venv/
data/*
!data/.gitkeep
# The eval corpus is a fixture, not user data: eval/questions.jsonl is
# written against it, so CI scores an empty index without it.
!data/sample_hr_policy.md
.pytest_cache/

# Fine-tuning artefacts: the trained adapter is reproducible from
# finetune/train_lora.py in one command, so the weights are not versioned.
# The eval result JSONs ARE committed - they are the evidence.
finetune/out/adapter/
finetune/out/*.log
# Generated by build_dataset.py and deterministic for a given seed
# (tests/test_finetune_dataset.py asserts that), so the inputs are versioned
# and the 554KB output is not.
finetune/data/
